{
  "name": "coolreader",
  "version": "1.4.1",
  "private": true,
  "main": "./out/main/index.js",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "dist": "npm run build && electron-builder",
    "preview": "electron-vite preview"
  },
  "build": {
    "appId": "com.coolreader.app",
    "productName": "CoolReader",
    "directories": {
      "output": "release"
    },
    "files": [
      "out/**/*"
    ],
    "win": {
      "target": [
        "portable",
        "nsis"
      ],
      "icon": "coolreader_icon.ico"
    },
    "mac": {
      "target": [
        "dmg"
      ],
      "icon": "coolreader_icon_1024.png"
    },
    "linux": {
      "target": [
        "AppImage"
      ],
      "icon": "coolreader_icon_256.png"
    }
  },
  "dependencies": {
    "epubjs": "^0.3.93",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "webdav": "^5.10.0"
  },
  "devDependencies": {
    "@types/react": "^18.2.0",
    "@types/react-dom": "^18.2.0",
    "@vitejs/plugin-react": "^4.2.0",
    "electron": "^28.0.0",
    "electron-builder": "^26.8.1",
    "electron-vite": "^2.0.0",
    "typescript": "^5.3.0",
    "vite": "^5.0.0"
  }
}
